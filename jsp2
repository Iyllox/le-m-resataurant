* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: Arial, sans-serif;
  background: #111;
  color: white;
}


/* =========================
   NAVBAR
========================= */

.navbar {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  padding: 25px 7%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 100;
}

.logo {
  font-size: 28px;
  font-weight: 800;
  letter-spacing: 4px;
}

nav {
  display: flex;
  gap: 25px;
}

nav a {
  color: white;
  text-decoration: none;
  font-size: 14px;
  transition: color .25s ease;
}

nav a:hover {
  color: #d6a84f;
}

.menu-toggle {
  display: none;
  background: transparent;
  border: none;
  color: white;
  font-size: 30px;
  cursor: pointer;
}


/* =========================
   HERO
========================= */

.hero {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  padding: 120px 8%;
  overflow: hidden;

  background:
    linear-gradient(
      120deg,
      #19130d,
      #3b2a18,
      #0c0c0c
    );
}

.hero-overlay {
  position: absolute;
  inset: 0;

  background:
    radial-gradient(
      circle at 70% 40%,
      rgba(255,255,255,.08),
      transparent 40%
    );
}

.hero-content {
  position: relative;
  z-index: 2;
  max-width: 650px;

  animation: appear 1s ease forwards;
}

.subtitle {
  font-size: 12px;
  letter-spacing: 3px;
  margin-bottom: 20px;
  opacity: .7;
  font-weight: 600;
}

h1 {
  font-size: clamp(60px, 12vw, 120px);
  line-height: .85;
  margin-bottom: 30px;
}

h1 span {
  display: block;
  font-size: .48em;
  font-weight: 400;
}

.description {
  color: #ccc;
  font-size: 18px;
  max-width: 500px;
  line-height: 1.6;
  margin-bottom: 35px;
}

.buttons {
  display: flex;
  gap: 15px;
  flex-wrap: wrap;
}

.button {
  display: inline-block;
  padding: 15px 22px;
  text-decoration: none;
  border-radius: 4px;
  font-weight: 700;
  font-size: 14px;

  transition:
    transform .25s ease,
    opacity .25s ease;
}

.button:hover {
  transform: translateY(-3px);
  opacity: .85;
}

.primary {
  background: white;
  color: black;
}

.secondary {
  border: 1px solid #777;
  color: white;
}

.scroll {
  position: absolute;
  bottom: 30px;
  left: 50%;
  transform: translateX(-50%);

  font-size: 11px;
  letter-spacing: 2px;
  color: #aaa;

  text-transform: uppercase;
  text-align: center;
}

.scroll span {
  display: block;
  width: 1px;
  height: 35px;

  background: #aaa;

  margin: 0 auto 10px;
}


/* =========================
   À PROPOS
========================= */

.about-section {
  padding: 110px 8%;
  background: #151515;
  text-align: center;
  position: relative;
}

.about-content {
  max-width: 800px;
  margin: auto;
}

.about-content h2 {
  font-family: Georgia, serif;
  font-size: clamp(40px, 6vw, 65px);
  color: #d6a84f;

  margin: 15px 0 30px;

  line-height: 1.1;
}

.about-content p:not(.menu-subtitle) {
  color: #aaa;
  font-size: 17px;
  line-height: 1.8;
  margin-bottom: 18px;
}

.menu-subtitle {
  color: #d6a84f;
  font-size: 12px;
  letter-spacing: 4px;
  font-weight: bold;
}


/* =========================
   MENU
========================= */

.menu-section {
  padding: 110px 7%;
  background: #111;
}

.menu-header {
  max-width: 750px;
  margin: 0 auto 60px;
  text-align: center;
}

.menu-header h2 {
  font-family: Georgia, serif;
  font-size: clamp(48px, 7vw, 75px);

  color: #d6a84f;

  margin: 12px 0 20px;
}

.menu-header > p:last-child {
  color: #999;
  line-height: 1.7;
}

.menu-grid {
  max-width: 1200px;
  margin: auto;

  display: grid;

  grid-template-columns: repeat(2, 1fr);

  gap: 25px;
}

.menu-category {
  background: #151515;

  border: 1px solid rgba(214, 168, 79, .25);

  padding: 35px;

  transition:
    transform .3s ease,
    border-color .3s ease;
}

.menu-category:hover {
  transform: translateY(-5px);
  border-color: rgba(214, 168, 79, .65);
}

.menu-category h3 {
  text-align: center;

  color: #d6a84f;

  font-family: Georgia, serif;

  font-size: 30px;

  text-transform: uppercase;

  letter-spacing: 2px;

  margin-bottom: 25px;
}

.menu-category h3 small {
  display: block;

  font-family: Arial, sans-serif;

  font-size: 11px;

  font-weight: normal;

  letter-spacing: 1px;

  text-transform: none;

  color: #888;

  margin-top: 5px;
}

.menu-item {
  display: flex;

  align-items: baseline;

  justify-content: space-between;

  gap: 20px;

  padding: 13px 0;

  border-bottom: 1px dotted #444;
}

.menu-item span {
  color: #ddd;

  line-height: 1.5;
}

.menu-item strong {
  color: #d6a84f;

  white-space: nowrap;

  font-size: 15px;
}

.menu-item small {
  color: #888;

  font-size: 12px;
}

.menu-description {
  color: #aaa;

  text-align: center;

  line-height: 1.7;

  margin: 10px 0 20px;
}

.menu-accompagnement {
  color: #d6a84f;

  text-align: center;

  font-size: 13px;

  margin-bottom: 15px;
}

.menu-extra {
  color: #888;

  font-size: 12px;

  text-align: center;

  margin-top: 12px;
}

.menu-price-big {
  text-align: center;

  color: #d6a84f;

  font-size: 25px;

  font-weight: bold;

  margin-top: 20px;
}

.menu-special {
  margin-top: 20px;

  padding: 15px;

  border: 1px solid rgba(214, 168, 79, .3);

  color: #ddd;

  display: flex;

  justify-content: space-between;

  gap: 15px;
}

.menu-special strong {
  color: #d6a84f;

  white-space: nowrap;
}

.menu-special small {
  color: #888;
}

.fruit-list {
  color: #aaa;

  text-align: center;

  line-height: 1.8;

  margin-top: 10px;
}


/* =========================
   BRUNCH
========================= */

.brunch-section {
  max-width: 1200px;

  margin: 100px auto 0;
}

.brunch-grid {
  display: grid;

  grid-template-columns: repeat(3, 1fr);

  gap: 20px;
}

.brunch-card {
  padding: 30px;

  background: #151515;

  border: 1px solid rgba(214, 168, 79, .3);

  text-align: center;
}

.brunch-card h3 {
  color: #d6a84f;

  font-family: Georgia, serif;

  font-size: 24px;

  margin-bottom: 8px;
}

.brunch-price {
  color: white;

  font-size: 22px;

  font-weight: bold;

  margin-bottom: 20px;
}

.brunch-card p {
  color: #aaa;

  font-size: 13px;

  line-height: 1.6;

  margin-bottom: 10px;
}

.brunch-unit {
  max-width: 650px;

  margin: 30px auto 0;

  padding: 35px;

  background: #151515;

  border: 1px solid rgba(214, 168, 79, .25);
}

.brunch-unit h3,
.brunch-hours h3 {
  text-align: center;

  color: #d6a84f;

  font-family: Georgia, serif;

  font-size: 26px;

  margin-bottom: 20px;
}

.brunch-hours {
  text-align: center;

  margin-top: 35px;
}

.brunch-hours p {
  color: #aaa;

  margin: 8px;
}

.brunch-hours strong {
  color: #ddd;
}


/* =========================
   GALERIE
========================= */

.gallery-section {
  padding: 110px 7%;

  background: #151515;
}

.gallery-header {
  max-width: 750px;

  margin: 0 auto 60px;

  text-align: center;
}

.gallery-header h2 {
  font-family: Georgia, serif;

  font-size: clamp(45px, 7vw, 70px);

  color: #d6a84f;

  margin: 12px 0 20px;
}

.gallery-header > p:last-child {
  color: #999;

  line-height: 1.7;
}

.gallery-grid {
  max-width: 1200px;

  margin: auto;

  display: grid;

  grid-template-columns: 1.4fr 1fr;

  grid-template-rows: 300px 300px;

  gap: 15px;
}

.gallery-item {
  position: relative;

  overflow: hidden;

  cursor: pointer;

  background: #111;
}

.gallery-main {
  grid-row: span 2;
}

.gallery-item img {
  width: 100%;
  height: 100%;

  object-fit: cover;

  display: block;

  transition: transform .5s ease;
}

.gallery-item:hover img {
  transform: scale(1.05);
}

.gallery-overlay {
  position: absolute;

  inset: 0;

  display: flex;

  align-items: flex-end;

  padding: 25px;

  background:
    linear-gradient(
      transparent,
      rgba(0,0,0,.75)
    );

  opacity: 0;

  transition: opacity .3s ease;
}

.gallery-item:hover .gallery-overlay {
  opacity: 1;
}

.gallery-overlay span {
  color: white;

  font-size: 14px;

  letter-spacing: 2px;

  text-transform: uppercase;
}


/* =========================
   LIGHTBOX
========================= */

.lightbox {
  position: fixed;

  inset: 0;

  background: rgba(0, 0, 0, .92);

  display: flex;

  align-items: center;

  justify-content: center;

  padding: 30px;

  opacity: 0;

  visibility: hidden;

  transition:
    opacity .3s ease,
    visibility .3s ease;

  z-index: 9999;
}

.lightbox.active {
  opacity: 1;

  visibility: visible;
}

.lightbox img {
  max-width: 95%;

  max-height: 90vh;

  object-fit: contain;

  border: 1px solid #d6a84f;

  box-shadow:
    0 0 40px rgba(0, 0, 0, .8);
}

.lightbox-close {
  position: absolute;

  top: 20px;
  right: 25px;

  background: transparent;

  border: none;

  color: white;

  font-size: 45px;

  cursor: pointer;

  z-index: 10000;
}

.lightbox-close:hover {
  color: #d6a84f;
}


/* =========================
   CONTACT
========================= */

.contact-section {
  padding: 110px 7%;

  background: #101010;
}

.contact-header {
  max-width: 750px;

  margin: 0 auto 60px;

  text-align: center;
}

.contact-header h2 {
  font-family: Georgia, serif;

  font-size: clamp(45px, 7vw, 70px);

  color: #d6a84f;

  margin: 12px 0 20px;
}

.contact-header > p:last-child {
  color: #999;

  line-height: 1.7;
}

.contact-grid {
  max-width: 1100px;

  margin: auto;

  display: grid;

  grid-template-columns: repeat(3, 1fr);

  gap: 20px;
}

.contact-card {
  background: #151515;

  border: 1px solid rgba(214, 168, 79, .25);

  padding: 35px;

  text-align: center;
}

.contact-icon {
  display: block;

  color: #d6a84f;

  font-size: 30px;

  margin-bottom: 15px;
}

.contact-card h3 {
  font-family: Georgia, serif;

  color: #d6a84f;

  font-size: 24px;

  margin-bottom: 15px;
}

.contact-card p {
  color: #aaa;

  line-height: 1.7;

  margin-bottom: 20px;
}

.contact-button {
  display: inline-block;

  padding: 12px 18px;

  border: 1px solid #d6a84f;

  color: #d6a84f;

  text-decoration: none;

  font-size: 13px;

  transition:
    background .25s ease,
    color .25s ease;
}

.contact-button:hover {
  background: #d6a84f;

  color: #111;
}

.hours-list {
  text-align: left;

  margin-top: 10px;
}

.hours-list div {
  display: flex;

  justify-content: space-between;

  gap: 15px;

  padding: 9px 0;

  border-bottom: 1px dotted #444;
}

.hours-list span {
  color: #aaa;

  font-size: 13px;
}

.hours-list strong {
  color: #ddd;

  font-size: 13px;

  text-align: right;
}

.temporary-hours {
  color: #777 !important;

  font-size: 11px;

  margin-top: 15px !important;
}


/* =========================
   FOOTER
========================= */

footer {
  padding: 30px;

  text-align: center;

  color: #777;

  background: #080808;

  font-size: 12px;
}


/* =========================
   ANIMATION
========================= */

@keyframes appear {

  from {
    opacity: 0;

    transform: translateY(25px);
  }

  to {
    opacity: 1;

    transform: translateY(0);
  }

}


/* =========================
   MOBILE
========================= */

@media (max-width: 800px) {

  .menu-section {
    padding: 80px 18px;
  }

  .menu-grid {
    grid-template-columns: 1fr;

    gap: 15px;
  }

  .menu-category {
    padding: 25px 18px;
  }

  .menu-category:hover {
    transform: none;
  }

  .menu-category h3 {
    font-size: 25px;
  }

  .menu-item {
    gap: 10px;

    font-size: 14px;
  }

  .menu-item strong {
    font-size: 14px;
  }

  .brunch-grid {
    grid-template-columns: 1fr;
  }

  .brunch-unit {
    padding: 25px 18px;
  }

  .gallery-grid {
    grid-template-columns: 1fr;

    grid-template-rows:
      300px
      220px
      220px
      220px;
  }

  .gallery-main {
    grid-row: auto;
  }

  .contact-grid {
    grid-template-columns: 1fr;
  }

}


@media (max-width: 600px) {

  .navbar {
    padding: 20px;
  }

  .menu-toggle {
    display: block;
  }

  .navbar nav {
    position: absolute;

    top: 75px;
    right: 20px;

    width: 200px;

    padding: 15px;

    background: rgba(15, 15, 15, .97);

    border: 1px solid rgba(214, 168, 79, .4);

    display: none;

    flex-direction: column;

    gap: 0;
  }

  .navbar nav.active {
    display: flex;
  }

  .navbar nav a {
    padding: 15px 10px;

    font-size: 14px;

    border-bottom: 1px solid #333;
  }

  .navbar nav a:last-child {
    border-bottom: none;
  }

  .hero {
    padding: 120px 25px 70px;
  }

  h1 {
    font-size: 70px;
  }

  .about-section {
    padding: 80px 25px;
  }

  .about-content h2 {
    font-size: 42px;
  }

  .gallery-section {
    padding: 80px 18px;
  }

  .gallery-grid {
    grid-template-rows:
      260px
      210px
      210px
      210px;
  }

  .gallery-overlay {
    opacity: 1;
  }

  .contact-section {
    padding: 80px 18px;
  }

  .contact-card {
    padding: 28px 20px;
  }

  .lightbox {
    padding: 15px;
  }

  .lightbox img {
    max-width: 100%;
    max-height: 85vh;
  }

  .lightbox-close {
    top: 10px;
    right: 15px;
    font-size: 40px;
  }

}